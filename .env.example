# Required only when using a geocoding provider that needs a custom identifier or endpoint.
GEOCODER_USER_AGENT=Sakay-Transit-Planner/0.1 (contact: your-team@example.com)
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
PORT=3000

# Live schedule routing remains disabled until every value below identifies one
# approved, checksummed pilot graph. See docs/PILOT_ROUTING_RUNBOOK.md.
OTP_GRAPHQL_URL=https://otp.example.org/graphql
OTP_API_VERSION=2.x.y
OTP_DATA_VERSION=official-feed-version-or-effective-date
OTP_DATA_MANIFEST_ID=mrt3-YYYY-MM-DD-release-a
OTP_SUPPORT_BOUNDARY=MRT-3 pilot corridor only

# Required for live routing after unattended eligibility checks pass. This file
# is generated outside public assets by `npm run pilot:readiness`.
PILOT_RELEASE_STATE_PATH=/srv/sakay-state/pilot-readiness/status.json
